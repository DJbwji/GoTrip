# Copy to .env. Configuration is loaded automatically.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set a long random secret for deployment:
# DJANGO_SECRET_KEY=replace-me
DEMO_PAYMENTS=1
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
MODERATOR_EMAIL=moderator@gotrip.local
DEFAULT_FROM_EMAIL=GoTrip <noreply@gotrip.local>

# To send real emails, set the SMTP backend and credentials:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=account@example.com
# EMAIL_HOST_PASSWORD=application-password
# EMAIL_USE_TLS=1

# SQLite works by default. For PostgreSQL install psycopg[binary] first.
# POSTGRES_DB=gotrip
# POSTGRES_USER=gotrip
# POSTGRES_PASSWORD=local-password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
